# -----------------------------------------------------------------------------
# Our Memories — web app environment.
# Copy to .env.local for development. Never commit real values.
# Only NEXT_PUBLIC_* values are ever sent to the browser.
# -----------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Bypasses RLS — used for public share pages, cron and rate limiting.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (R2 → Manage API tokens; Object Read & Write on the bucket)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=our-memories
# Not used: the bucket stays private and all media is served through
# short-lived presigned URLs. Never attach a public domain to this bucket.
# R2_PUBLIC_URL=

# Public base URL of the app, used to build share links.
APP_URL=http://localhost:3000
# IANA timezone that defines days and months (e.g. Europe/London, Asia/Manila).
# Must match the worker's APP_TIMEZONE.
APP_TIMEZONE=UTC

# Protects /api/cron/*. Vercel sends it automatically as a Bearer token.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# 32 random bytes, base64. Encrypts share tokens so links can be copied again.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SHARE_TOKEN_ENCRYPTION_KEY=

# Optional: start the GitHub Actions recap worker the moment a recap is requested.
# Fine-grained token with "Actions: Read and write" on this repository only.
# Without it, the workflow's schedule still picks jobs up (within ~3 hours).
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPOSITORY=your-github-username/our-memories

# Optional: maximum size of a single uploaded photo, in MB (default 40).
# UPLOAD_MAX_MB=40

# Optional: the memory space anyone with the site link can browse read-only
# (months and photos; no adding, editing, sharing, downloads or recap generation).
# Leave empty to use the only space in the database.
# PUBLIC_COUPLE_ID=
