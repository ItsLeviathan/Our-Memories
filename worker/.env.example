# -----------------------------------------------------------------------------
# Our Memories — recap worker environment. Never commit real values.
# -----------------------------------------------------------------------------

# Same Supabase project as the web app (service role: this is a trusted process).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same R2 bucket as the web app.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=our-memories

# Optional tuning (defaults shown).
# WORKER_ID=                 # defaults to hostname-pid
# POLL_INTERVAL_MS=10000     # how often to look for queued jobs
# STALE_AFTER_SECONDS=900    # jobs without a heartbeat this long are retried
# JOB_TIMEOUT_MS=1800000     # hard limit per render (30 min)
# PORT=8080                  # health check endpoint
# FFMPEG_PATH=ffmpeg
# RENDER_CONCURRENCY=2
# RECAP_MAX_PHOTOS=80
# RECAP_SHOW_DATES=true
# RECAP_TAGLINE=A month of us.
# RECAP_CLOSING_LINE=A month worth remembering.
