{
  "name": "our-memories-worker",
  "version": "1.0.0",
  "description": "Recap video worker for Our Memories",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "render:sample": "tsx scripts/render-sample.ts"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@supabase/supabase-js": "^2.117.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.9"
  }
}
